<!DOCTYPE html>
<html lang = "en">

    <head>
        <meta charset = "utf-8">
        <title>Order History</title>
        <link rel = "stylesheet" href = "style.css" type = "text/css">
    </head>

    <body>
        <div class = "header">
            <a href="/" id = "home">Home</a>
        </div>

        <div class = "bg">
            <img id = "stain" src = "images/drink_stain.png" alt = "Image of a coffee stain.">

            <h1>Order History</h1>

            <form action = "/orderHistoryList" method = "post">
                
                <fieldset>
                    <span class = "category">Enter Name Here:</span><br><br>

                    <input id = "historyName" type = "text" name = "orderName">

                </fieldset><br>
                
                <input type = "reset">
                <input type = "submit" value = "Submit">
            
            </form>
        </div>
    </body>
</html>